#!/usr/bin/env python3
"""The pull request body section check, on the agent's PATH so a stage prompt calls it by name.

The plugin puts this directory on the agent's PATH. The check lives in
`core/pr_body.py`; this file only finds it. Python 3.8 must still parse this
file.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from core.pr_body import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
