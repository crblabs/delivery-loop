#!/usr/bin/env python3
"""The no-unicode-dash rule, on the agent's PATH so a stage prompt calls it by name.

The plugin puts this directory on the agent's PATH. The rule lives in
`core/no_unicode_dash.py`; this file only finds it. Python 3.8 must still parse
this file.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from core.no_unicode_dash import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
