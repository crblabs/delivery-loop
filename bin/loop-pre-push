#!/usr/bin/env python3
"""The pre-push gate, on the PATH of a push the agent runs.

The plugin puts this directory on the agent's PATH. The gate lives in
`core/pre_push.py`; this file only finds it. Python 3.8 must still parse
this file.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from core.pre_push import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
